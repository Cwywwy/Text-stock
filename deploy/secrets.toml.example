# 文件：secrets.toml.example
# 作者：Cwywwy
# 用途：国内服务器上的 Streamlit Secrets 模板。复制成 .streamlit/secrets.toml 后填值。
# 所属模块：deploy（部署物料，不参与打包）
#
# 复制与收紧权限：
#   sudo -u stockplan cp deploy/secrets.toml.example /opt/stock-plan/.streamlit/secrets.toml
#   sudo chown stockplan:stockplan /opt/stock-plan/.streamlit/secrets.toml
#   sudo chmod 600 /opt/stock-plan/.streamlit/secrets.toml
#
# Revision History:
#   2026-10-29  add secrets template for china cloud deployment (phase 3)

# ---- LLM（必填；智谱 GLM 的免费额度够个人日常用）----
LLM_BASE_URL = "https://open.bigmodel.cn/api/paas/v4"
LLM_MODEL = "glm-4-flash"
LLM_API_KEY = "把你的 key 填在这里"

# ---- 形态开关（与 systemd unit 里的 Environment 一致，重复写更稳妥）----
# 服务器只消费快照：并发降为云端轻量模式
STOCK_PLAN_CLOUD = "1"
# 关掉本机才该跑的启动副作用（自动发布策略、同步境外 raw 链接）
STOCK_PLAN_SERVICE = "1"
STOCK_PLAN_REMOTE_SYNC = "0"

# ---- 快照仓库（默认 Cwywwy/Text-stock，一般不用改）----
# DATA_SNAPSHOT_REPO = "Cwywwy/Text-stock"
# 只有私有仓库拉取才需要令牌；公开仓库留空即可，千万别把 token 提交进 git
# DATA_SNAPSHOT_TOKEN = ""
